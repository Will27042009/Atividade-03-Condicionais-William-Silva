Algoritmo "algoritmo4"

Var
   contador, numero, multiplicacao: inteiro

Inicio
   escreval("Digite um numero de 1 a 10")
   leia(numero)

   para contador de 1 ate 10 passo 1 faca
      multiplicacao <- contador * numero
      escreval(contador, " x", numero, " =", multiplicacao)
   fimpara


Fimalgoritmo